{
  "extraKnownMarketplaces": {
    "kosmomorphia-estate": {
      "source": { "source": "directory", "path": "/home/user/kosmomorphia-plugin" }
    }
  },
  "enabledPlugins": {
    "kosmomorphia@kosmomorphia-estate": true
  },
  "env": {
    "KOSMO_ROOT": "/home/user/kosmomorphia-plugin"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ESTATE_MOUNT/bootstrap_estate.sh\" || true",
            "timeout": 600,
            "statusMessage": "Restoring KOSMOMORPHIA estate mirror"
          }
        ]
      }
    ]
  }
}
